                <mxCell id="VFJaxEmsMhs_FVUVy03t-89" value="End.&lt;br&gt;A/C can be operated by&lt;br&gt;the new operator" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="VFJaxEmsMhs_FVUVy03t-10" vertex="1">
