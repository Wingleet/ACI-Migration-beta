        <mxCell id="9J_GNHYtl3PKh8s9M4GL-0" value="&lt;b&gt;Order Management &lt;/b&gt;&lt;br&gt;Manual generation of T-order &lt;br&gt;from scratch to move material between stations" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=bottom;spacingTop=0;spacingBottom=0;spacingLeft=2;spacingRight=2;align=left;fillColor=#82C76B;strokeColor=#3A5431;fontColor=#000000;flipV=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="zzo48K5w6el02u5jim_O-1" vertex="1">
