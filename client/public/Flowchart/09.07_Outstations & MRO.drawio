        <mxCell id="9J_GNHYtl3PKh8s9M4GL-7" value="- &lt;b&gt;Semi-automated T-order process&lt;/b&gt;. User manually multi select the parts in status &quot;To Transfer&quot; and the system automatically&amp;nbsp; creates a T-order&lt;br&gt;- &lt;b&gt;Fully automated T-order Process&lt;/b&gt;. T-orders automaticaly created from a scheduler task based on part request request in stauts &quot;To Transfer&quot; and other criteria defined in a rule engine" style="rounded=1;whiteSpace=wrap;html=1;align=left;horizontal=1;spacingLeft=2;spacingRight=2;spacingBottom=2;spacingTop=2;" parent="zzo48K5w6el02u5jim_O-1" vertex="1">
          <mxGeometry x="-2273" y="438" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="9J_GNHYtl3PKh8s9M4GL-10" value="- &lt;b&gt;Semi-automated T-order process&lt;/b&gt;. User manually multi select the parts in status &quot;Below or Equal Reorder Level&quot; and system automatically&amp;nbsp; creates a T-order&lt;br&gt;- &lt;b&gt;Fully automated T-order Process&lt;/b&gt;. T-order process automaticaly created from a scheduler task based on part numbers in stauts &quot;Equal or Below Reorder Level&quot;" style="rounded=1;whiteSpace=wrap;html=1;align=left;horizontal=1;spacingLeft=2;spacingRight=2;spacingBottom=2;spacingTop=2;" parent="zzo48K5w6el02u5jim_O-1" vertex="1">
          <mxGeometry x="-1543" y="437.37" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="9J_GNHYtl3PKh8s9M4GL-11" value="- &lt;b&gt;Semi-automated T-order process&lt;/b&gt;. User manually multi select the U/S parts in the &quot;source&quot; station, select the &quot;destination&quot; Station/Store, and the system automatically creates a T-order" style="rounded=1;whiteSpace=wrap;html=1;align=left;horizontal=1;spacingLeft=2;spacingRight=2;spacingBottom=2;spacingTop=2;" parent="zzo48K5w6el02u5jim_O-1" vertex="1">
          <mxGeometry x="-1902.4" y="731.87" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="9J_GNHYtl3PKh8s9M4GL-12" value="- &lt;b&gt;Full manual T-order process&lt;/b&gt;. User manually enters all info both at header level (Station/Store &quot;from&quot; and &quot;to&quot;) and at detail level (all part numbers and quantity to transfer)" style="rounded=1;whiteSpace=wrap;html=1;align=left;horizontal=1;spacingLeft=2;spacingRight=2;spacingBottom=2;spacingTop=2;" parent="zzo48K5w6el02u5jim_O-1" vertex="1">
          <mxGeometry x="-1535.4" y="730.87" width="300" height="96" as="geometry" />
        </mxCell>
