        <mxCell id="9v7zMtN0XV_v5VDUjUib-12" value="- Issue a Transfer Pickslip. Material Allocation will allocate the best part accoridng to rule set in APN 229.&lt;br&gt;- Differen parts can be selected during confirmation" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=bottom;spacingTop=0;spacingBottom=0;spacingLeft=2;spacingRight=2;align=left;fillColor=#fff2cc;strokeColor=#d6b656;flipV=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="TVyqgcXE4ki6PRG703s3-1" vertex="1">
